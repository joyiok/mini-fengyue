{$APP_DOMAIN} {
    # Caddy supplies the TLS certificate automatically when APP_DOMAIN is a
    # real DNS name. For a private/IP-only test, set APP_DOMAIN=:80.
    reverse_proxy sillytavern:8000

    encode zstd gzip

    header {
        # Basic browser hardening. SillyTavern still owns its session and CSRF
        # protection; these headers do not replace application authentication.
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }

    # No `log` block on purpose: SillyTavern writes its own access log to
    # data/access.log, and Caddy's default error-only logging to the container
    # output is enough for a single-user deployment.

    # Do not add `admin off` here: the Compose healthcheck probes Caddy's local
    # admin API on 127.0.0.1:2019, which also keeps the endpoint off the network.
}
