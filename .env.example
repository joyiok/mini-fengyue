# Public hostname(s). Use a real DNS name for automatic HTTPS, for example:
# APP_DOMAIN=chat.example.com
# Several hosts are allowed, separated by commas or spaces; Caddy serves all of
# them and obtains a certificate for each (so list every name that resolves to
# this server, otherwise that name gets no certificate):
# APP_DOMAIN=chat.example.com, www.chat.example.com
# For an IP-only/private-network test, use the port-only form:
# APP_DOMAIN=:80
APP_DOMAIN=:80

# Optional ACME contact address. Leave empty if you do not need to set one.
CADDY_EMAIL=

# Time zone used by the containers and by the scheduled backup units in
# deploy/systemd.
TZ=Asia/Shanghai

# Where the SillyTavern image comes from. The official registry is ghcr.io.
# If your network cannot reach it reliably, point this at a mirror that proxies
# ghcr.io (replace the whole registry prefix, e.g.):
#   SILLYTAVERN_IMAGE=ghcr.nju.edu.cn/sillytavern/sillytavern
SILLYTAVERN_IMAGE=ghcr.io/sillytavern/sillytavern

# Image tag. `latest` follows the stable release branch and is a moving target;
# pin a concrete version for a reproducible deployment, for example:
#   SILLYTAVERN_VERSION=1.13.4
SILLYTAVERN_VERSION=latest

# Caddy comes from Docker Hub. This is the complete image reference, tag
# included, so a Docker Hub mirror can be dropped straight in, for example:
#   CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine
CADDY_IMAGE=caddy:2-alpine

# Host UID/GID for files created in mounted directories.
PUID=1000
PGID=1000

# Host-side port used only for local troubleshooting. Keep it bound to loopback.
ST_LOCAL_PORT=127.0.0.1:8000

# Number of local archives retained by scripts/backup.sh and scripts/update.sh.
# Set to 0 to keep every archive instead of rotating.
BACKUP_KEEP=14
