# Public hostname. Use a real DNS name for automatic HTTPS, for example:
# APP_DOMAIN=chat.example.com
# For an IP-only/private-network test, use:
# APP_DOMAIN=:80
APP_DOMAIN=:80

# Optional ACME contact address. Leave empty if you do not need to set one.
CADDY_EMAIL=

# Time zone used by containers and scheduled backups.
TZ=Asia/Shanghai

# Run the official SillyTavern image from the stable release branch.
SILLYTAVERN_VERSION=latest

# Host UID/GID for files created in mounted directories.
PUID=1000
PGID=1000

# Host-side port used only for local troubleshooting. Keep it bound to loopback.
ST_LOCAL_PORT=127.0.0.1:8000

