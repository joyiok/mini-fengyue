root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[{Caddyfile,docker-compose.yml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false
